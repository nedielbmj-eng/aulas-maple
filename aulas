// Storage com fallback em memória caso localStorage bloqueado
const _mem={};
const ST={
  g:function(k){
    try{
      const v=localStorage.getItem(k);
      if(v)return{value:v};
      return _mem[k]?{value:_mem[k]}:null;
    }catch(e){
      return _mem[k]?{value:_mem[k]}:null;
    }
  },
  s:function(k,v){
    try{
      localStorage.setItem(k,v);
      _mem[k]=v;
    }catch(e){
      _mem[k]=v;
      console.warn("localStorage bloqueado, usando memória:",e);
