<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Diário de Tecnologia</title>
<style>
:root{
  --purple:#534AB7;--purple-light:#EEEDFE;--purple-mid:#7F77DD;--purple-dark:#3C3489;--purple-border:#AFA9EC;
  --teal:#1D9E75;--teal-light:#E1F5EE;--teal-dark:#085041;
  --red:#E24B4A;--red-light:#FCEBEB;--red-dark:#791F1F;
  --amber:#EF9F27;--amber-light:#FAEEDA;--amber-dark:#633806;
  --coral:#D85A30;--coral-light:#FAECE7;--coral-dark:#712B13;
  --green:#639922;--green-light:#EAF3DE;--green-dark:#27500A;
  --bg:#F7F6F3;--bg2:#EFEFEB;--bg3:#E5E3DC;
  --text:#1A1916;--text2:#5A5854;--text3:#888780;
  --border:#D3D1C7;--border2:#C2C0B6;
  --r:10px;--rs:6px;--rl:14px;
  --shadow:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.06);
  --font:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --mono:"Courier New",monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font);background:var(--bg);color:var(--text);min-height:100vh}
#app{max-width:700px;margin:0 auto;padding:1.25rem 1rem 4rem}
.topbar{background:var(--purple);border-radius:var(--rl);padding:1rem 1.25rem;margin-bottom:1.25rem;display:flex;align-items:center;justify-content:space-between;box-shadow:0 4px 20px rgba(83,74,183,.35)}
.ti{width:40px;height:40px;border-radius:var(--rs);background:var(--purple-mid);display:flex;align-items:center;justify-content:center;color:#EEEDFE;font-size:22px;flex-shrink:0}
.tt{font-size:17px;font-weight:600;color:#EEEDFE;letter-spacing:-.3px}
.ts{font-size:12px;color:var(--purple-border);margin-top:1px}
.tr{text-align:right}
.tc{font-family:var(--mono);font-size:18px;font-weight:500;color:#EEEDFE;letter-spacing:1px}
.td{font-size:11px;color:var(--purple-border);margin-top:2px}
.nav{display:flex;gap:3px;margin-bottom:1.25rem;background:var(--bg2);border-radius:var(--rl);padding:4px;border:.5px solid var(--border)}
.nb{flex:1;padding:7px 2px;font-size:10px;cursor:pointer;border:none;background:transparent;color:var(--text2);font-family:var(--font);border-radius:var(--rs);display:flex;align-items:center;justify-content:center;gap:3px;transition:all .15s;white-space:nowrap;font-weight:500}
.nb.active{background:var(--purple);color:#EEEDFE}
.nb:not(.active):hover{background:white;color:var(--text)}
.sec{display:none}.sec.active{display:block}
.sh{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
.st{font-size:15px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:7px}
.btn{display:inline-flex;align-items:center;gap:5px;padding:7px 14px;font-size:13px;cursor:pointer;border-radius:var(--rs);font-family:var(--font);border:none;font-weight:500;transition:all .15s}
.bp{background:var(--purple);color:#EEEDFE}.bp:hover{background:var(--purple-dark)}
.bt{background:var(--teal);color:var(--teal-light)}.bt:hover{background:var(--teal-dark)}
.bg{background:white;color:var(--text2);border:.5px solid var(--border)}.bg:hover{background:var(--bg2)}
.bai{background:var(--purple-mid);color:#EEEDFE}.bai:hover{background:var(--purple)}
.bc{background:var(--coral);color:var(--coral-light)}.bc:hover{background:var(--coral-dark)}
.bgr{background:var(--green);color:var(--green-light)}.bgr:hover{background:var(--green-dark)}
.card{background:white;border:.5px solid var(--border);border-radius:var(--rl);padding:1rem 1.25rem;margin-bottom:1rem;box-shadow:var(--shadow)}
.fc{background:white;border:.5px solid var(--purple-border);border-radius:var(--rl);padding:1.25rem;margin-bottom:1.25rem;border-top:3px solid var(--purple);box-shadow:var(--shadow)}
.fl{font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.06em;display:block;margin-bottom:5px}
.fi{width:100%;font-family:var(--font);font-size:14px;border-radius:var(--rs);border:.5px solid var(--border);background:var(--bg2);color:var(--text);padding:8px 10px;outline:none;margin-bottom:12px;transition:border-color .15s}
.fi:focus{border-color:var(--purple);box-shadow:0 0 0 3px rgba(83,74,183,.12);background:white}
textarea.fi{resize:vertical;min-height:72px}
.gr{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.gr .full{grid-column:1/-1}
.fa{display:flex;gap:8px;justify-content:flex-end;padding-top:4px}
.sg{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:1.25rem}
.sc{border-radius:var(--rl);padding:12px 14px;box-shadow:var(--shadow)}
.scp{background:var(--purple-light);border:.5px solid var(--purple-border)}
.sct{background:var(--teal-light);border:.5px solid #5DCAA5}
.scr{background:var(--red-light);border:.5px solid #F09595}
.sca{background:var(--amber-light);border:.5px solid var(--amber)}
.si{font-size:18px;margin-bottom:5px}
.sn{font-size:22px;font-weight:600;letter-spacing:-.5px}
.scp .sn{color:var(--purple-dark)}.sct .sn{color:var(--teal-dark)}.scr .sn{color:var(--red-dark)}.sca .sn{color:var(--amber-dark)}
.sl{font-size:11px;margin-top:1px;font-weight:500}
.scp .sl{color:var(--purple)}.sct .sl{color:var(--teal)}.scr .sl{color:var(--red-dark)}.sca .sl{color:var(--amber-dark)}
.tl{position:relative;padding-left:30px}
.tl::before{content:"";position:absolute;left:9px;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,var(--purple-mid),var(--teal))}
.tli{position:relative;margin-bottom:1.1rem}
.tld{position:absolute;left:-26px;top:14px;width:12px;height:12px;border-radius:50%;border:2.5px solid var(--bg);z-index:1}
.tlc{background:white;border:.5px solid var(--border);border-radius:var(--rl);padding:1rem 1.25rem;box-shadow:var(--shadow)}
.tlc:hover{border-color:var(--purple-border)}
.bdg{font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px}
.bpp{background:var(--teal-light);color:var(--teal-dark)}
.bpf{background:var(--red-light);color:var(--red-dark)}
.bpj{background:var(--amber-light);color:var(--amber-dark)}
.bpt{background:var(--purple-light);color:var(--purple-dark)}
.cg{display:flex;flex-direction:column;gap:4px;margin-top:8px}
.cr{display:flex;align-items:center;justify-content:space-between;padding:5px 10px;border-radius:var(--rs);background:var(--bg2)}
.cn{font-size:13px;color:var(--text)}
.sbw{display:flex;gap:4px}
.sb{font-size:11px;padding:2px 9px;border-radius:20px;cursor:pointer;border:none;font-family:var(--font);font-weight:600}
.ssp{background:var(--teal-light);color:var(--teal-dark)}.ssp.off{background:var(--bg3);color:var(--text3)}
.ssf{background:var(--red-light);color:var(--red-dark)}.ssf.off{background:var(--bg3);color:var(--text3)}
.ssj{background:var(--amber-light);color:var(--amber-dark)}.ssj.off{background:var(--bg3);color:var(--text3)}
.stars{display:flex;gap:3px}
.star{font-size:22px;cursor:pointer;color:var(--border2)}.star.on{color:var(--amber)}
.chip{font-size:12px;padding:3px 10px;border-radius:20px;background:var(--purple-light);color:var(--purple-dark);border:.5px solid var(--purple-border);display:inline-flex;align-items:center;gap:4px;font-weight:500}
.chip .rm{cursor:pointer;color:var(--purple);font-size:14px;line-height:1}
.aw{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.ar{display:flex;gap:6px;margin-top:8px}
.ar input{flex:1;font-family:var(--font);font-size:13px;padding:6px 10px;border-radius:var(--rs);border:.5px solid var(--border);background:var(--bg2);color:var(--text);outline:none}
.ar input:focus{border-color:var(--purple);background:white}
.ib{background:none;border:none;cursor:pointer;padding:5px 7px;color:var(--text3);font-size:16px;border-radius:var(--rs)}
.ib:hover{background:var(--bg2);color:var(--text)}
.eb{background:none;border:none;cursor:pointer;font-size:12px;color:var(--purple);padding:4px 0;font-family:var(--font);display:flex;align-items:center;gap:3px;margin-top:5px;font-weight:500}
.pr{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px}
.empty{text-align:center;padding:2.5rem 1rem;color:var(--text3);font-size:14px}
.ei{font-size:40px;display:block;margin-bottom:.75rem;opacity:.3}
.fb{display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap}
.fb input,.fb select{font-family:var(--font);font-size:13px;padding:7px 10px;border-radius:var(--rs);border:.5px solid var(--border);background:white;color:var(--text);outline:none;flex:1;min-width:120px}
.bim{display:flex;gap:4px;margin-bottom:1rem;background:var(--bg2);border-radius:var(--rl);padding:4px;border:.5px solid var(--border)}
.bb{flex:1;padding:7px 4px;font-size:12px;cursor:pointer;border:none;background:transparent;color:var(--text2);font-family:var(--font);border-radius:var(--rs);font-weight:500;transition:all .15s}
.bb.active{background:var(--coral);color:var(--coral-light)}
.nac{background:white;border:.5px solid var(--border);border-radius:var(--rl);padding:1rem 1.25rem;margin-bottom:.75rem;box-shadow:var(--shadow)}
.nh{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.nn{font-size:14px;font-weight:600;color:var(--text)}
.nm{font-size:12px;padding:3px 10px;border-radius:20px;font-weight:600}
.nr{display:flex;flex-direction:column;gap:8px}
.nrr{display:flex;align-items:center;gap:8px}
.nrl{font-size:12px;color:var(--text2);min-width:110px;font-weight:500}
.ni{width:70px;font-family:var(--mono);font-size:13px;padding:4px 8px;border-radius:var(--rs);border:.5px solid var(--border);background:var(--bg2);color:var(--text);outline:none;text-align:center}
.ni:focus{border-color:var(--purple);background:white}
.cb{display:flex;gap:4px;flex-wrap:wrap}
.cbtn{font-size:11px;padding:3px 10px;border-radius:20px;cursor:pointer;border:none;font-family:var(--font);font-weight:600}
.co{background:var(--teal-light);color:var(--teal-dark)}.co.off{background:var(--bg3);color:var(--text3)}
.crr{background:var(--amber-light);color:var(--amber-dark)}.crr.off{background:var(--bg3);color:var(--text3)}
.cp{background:var(--red-light);color:var(--red-dark)}.cp.off{background:var(--bg3);color:var(--text3)}
.no{flex:1;font-family:var(--font);font-size:12px;padding:4px 8px;border-radius:var(--rs);border:.5px solid var(--border);background:var(--bg2);color:var(--text);outline:none}
.ma{background:var(--purple-light);border:.5px solid var(--purple-border);border-radius:var(--rl);padding:.75rem 1rem;margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.mc{display:flex;gap:6px;flex-wrap:wrap}
.mcc{font-size:12px;padding:3px 10px;border-radius:20px;font-weight:600}
.ad{display:flex;gap:4px;margin-bottom:1rem;flex-wrap:wrap}
.db{padding:6px 14px;font-size:12px;cursor:pointer;border:.5px solid var(--border);border-radius:var(--rs);background:white;color:var(--text2);font-family:var(--font);font-weight:500;transition:all .15s}
.db.active{background:var(--purple);color:#EEEDFE;border-color:var(--purple)}
.as{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:var(--rs);margin-bottom:6px;border:.5px solid var(--border);background:white;transition:all .2s;box-shadow:var(--shadow)}
.as.tec{border-left:3px solid var(--purple);border-top-left-radius:0;border-bottom-left-radius:0}
.as.rob{border-left:3px solid var(--teal);border-top-left-radius:0;border-bottom-left-radius:0}
.as.oth{border-left:3px solid var(--border2);border-top-left-radius:0;border-bottom-left-radius:0}
.as.ea{background:var(--purple-light);border-color:var(--purple-border)}
.as.ep{background:var(--amber-light);border-color:var(--amber)}
.stm{font-family:var(--mono);font-size:12px;color:var(--text2);min-width:94px;line-height:1.5}
.sd{font-size:13px;font-weight:600}
.str{font-size:11px;color:var(--text3);margin-top:1px}
.ss{font-size:11px;margin-top:4px;font-weight:600;display:flex;align-items:center;gap:4px}
.scd{font-family:var(--mono);font-size:13px;font-weight:500;color:var(--purple);margin-left:auto;padding-left:8px}
.at{display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--purple-light);border-radius:var(--rl);margin-bottom:1rem;border:.5px solid var(--purple-border)}
.atl{font-size:13px;font-weight:600;color:var(--purple-dark)}
.ats{font-size:11px;color:var(--purple)}
.sw{position:relative;width:40px;height:22px;flex-shrink:0}
.sw input{opacity:0;width:0;height:0}
.sldr{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:var(--purple-border);border-radius:22px;transition:.2s}
.sldr:before{position:absolute;content:"";height:16px;width:16px;left:3px;bottom:3px;background:white;border-radius:50%;transition:.2s}
input:checked+.sldr{background:var(--purple)}
input:checked+.sldr:before{transform:translateX(18px)}
.ao{display:none;margin-bottom:1rem}.ao.show{display:block}
.ab{border-radius:var(--rl);padding:1.25rem;display:flex;align-items:flex-start;gap:12px;box-shadow:var(--shadow)}
.ab.warn{background:var(--amber-light);border:1.5px solid var(--amber)}
.ab.end{background:var(--red-light);border:1.5px solid var(--red)}
.abic{font-size:24px;flex-shrink:0}
.abt{font-size:15px;font-weight:600}
.ab.warn .abt{color:var(--amber-dark)}.ab.end .abt{color:var(--red-dark)}
.abs{font-size:13px;margin-top:3px}
.ab.warn .abs{color:#854F0B}.ab.end .abs{color:var(--red-dark)}
.ac{margin-left:auto;background:none;border:none;cursor:pointer;font-size:20px;color:var(--text3);padding:0 4px;border-radius:var(--rs);flex-shrink:0}
.rc{background:white;border:.5px solid var(--border);border-radius:var(--rl);padding:1rem 1.25rem;margin-bottom:1rem;border-left:3px solid var(--teal);border-top-left-radius:0;border-bottom-left-radius:0;box-shadow:var(--shadow)}
.pc{background:white;border:.5px solid var(--border);border-radius:var(--rl);padding:1rem 1.25rem;margin-bottom:1rem;border-left:3px solid var(--purple);border-top-left-radius:0;border-bottom-left-radius:0;box-shadow:var(--shadow)}
.aib{background:var(--purple-light);border:.5px solid var(--purple-border);border-radius:var(--rl);padding:1rem 1.25rem;margin-bottom:1.25rem}
.aia{width:32px;height:32px;border-radius:50%;background:var(--purple);display:flex;align-items:center;justify-content:center;color:#EEEDFE;font-size:16px;flex-shrink:0}
.air{background:white;border-radius:var(--rs);padding:.75rem 1rem;font-size:13px;color:var(--text);line-height:1.7;white-space:pre-wrap;border:.5px solid var(--purple-border)}
.ib2{background:var(--green-light);border:1.5px dashed #97C459;border-radius:var(--rl);padding:1.25rem;margin-bottom:12px;text-align:center;cursor:pointer}
.ib2:hover,.ib2.dv{background:#C0DD97}
.ib2 input{display:none}
.ip{background:white;border:.5px solid #97C459;border-radius:var(--rs);padding:.75rem 1rem;margin-top:10px}
.ich{display:flex;flex-wrap:wrap;gap:5px}
.icc{font-size:12px;padding:3px 9px;border-radius:20px;background:var(--green-light);color:var(--green-dark);border:.5px solid #97C459;font-weight:500}
.csr{display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap}
.csr label{font-size:12px;color:var(--text2)}
.csr select{font-family:var(--font);font-size:13px;padding:5px 8px;border-radius:var(--rs);border:.5px solid var(--border);background:var(--bg2);color:var(--text);outline:none}
.tm{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:12px}
.tmb{padding:6px 14px;font-size:12px;cursor:pointer;border:none;background:none;color:var(--text3);font-family:var(--font);border-bottom:2px solid transparent;margin-bottom:-1px;font-weight:500}
.tmb.active{color:var(--purple);border-bottom-color:var(--purple);font-weight:600}
.ta{width:40px;height:40px;border-radius:var(--rs);background:var(--purple-light);display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--purple);flex-shrink:0}
</style>
</head>
<body>
<div id="app">
<div class="topbar">
  <div style="display:flex;align-items:center;gap:10px">
    <div class="ti">💻</div>
    <div><div class="tt">Diário de Tecnologia</div><div class="ts">Gestão completa de aulas</div></div>
  </div>
  <div class="tr"><div class="tc" id="clk">--:--:--</div><div class="td" id="dt"></div></div>
</div>
<div class="nav">
  <button class="nb active" onclick="showTab('agenda')">📅 Agenda</button>
  <button class="nb" onclick="showTab('diario')">📓 Diário</button>
  <button class="nb" onclick="showTab('notas')">⭐ Notas</button>
  <button class="nb" onclick="showTab('turmas')">👥 Turmas</button>
  <button class="nb" onclick="showTab('relatorios')">📄 Relatórios</button>
  <button class="nb" onclick="showTab('planos')">🧠 Planos IA</button>
</div>

<div id="sec-agenda" class="sec active">
  <div id="ao" class="ao"></div>
  <div class="at"><div style="flex:1"><div class="atl">🔔 Alarmes de aula</div><div class="ats" id="ats">Avisa 5 min antes e quando acabar</div></div><label class="sw"><input type="checkbox" id="atgl" checked onchange="tgAlarm()"/><span class="sldr"></span></label></div>
  <div class="sh"><span class="st">📅 Agenda da semana</span></div>
  <div class="ad" id="adias"></div>
  <div id="aslots"></div>
</div>

<div id="sec-diario" class="sec">
  <div id="sw" class="sg" style="display:none"></div>
  <div class="sh"><span class="st">📖 Registros de aula</span><button class="btn bp" onclick="tgFA()">+ Nova aula</button></div>
  <div id="faw" style="display:none">
    <div class="fc">
      <div style="font-size:14px;font-weight:600;color:var(--purple-dark);margin-bottom:1rem">✏️ <span id="fatxt">Registrar aula</span></div>
      <div class="gr">
        <div><label class="fl">Data</label><input type="date" class="fi" id="fad"/></div>
        <div><label class="fl">Turma</label><select class="fi" id="fat" onchange="ldC()" style="margin-bottom:0"></select></div>
        <div class="full"><label class="fl">Conteúdo dado</label><textarea class="fi" id="fac" placeholder="Descreva o que foi trabalhado..."></textarea></div>
        <div class="full"><label class="fl">Nota da aula</label><div class="stars" id="stw"><span class="star" data-v="1" onclick="sN(1)">★</span><span class="star" data-v="2" onclick="sN(2)">★</span><span class="star" data-v="3" onclick="sN(3)">★</span><span class="star" data-v="4" onclick="sN(4)">★</span><span class="star" data-v="5" onclick="sN(5)">★</span></div></div>
        <div class="full"><label class="fl">Observações</label><input type="text" class="fi" id="fao" placeholder="Anotações opcionais" style="margin-bottom:0"/></div>
      </div>
      <div id="cw" style="display:none;margin-top:1rem"><label class="fl">Chamada</label><div id="cl" class="cg"></div></div>
      <div class="fa" style="margin-top:1rem"><button class="btn bg" onclick="canFA()">Cancelar</button><button class="btn bp" onclick="svA()">✓ Salvar</button></div>
    </div>
  </div>
  <div id="fd" style="display:none" class="fb"><input type="text" id="fdb" placeholder="Buscar..." oninput="rdD()"/><select id="fdt" onchange="rdD()"><option value="">Todas as turmas</option></select></div>
  <div id="tlw"></div>
</div>

<div id="sec-notas" class="sec">
  <div class="sh"><span class="st">⭐ Avaliações por turma</span></div>
  <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap;align-items:center">
    <select class="fi" id="nt" onchange="rdN()" style="margin-bottom:0;flex:1;min-width:140px"></select>
    <button class="btn bc" onclick="svN()">💾 Salvar notas</button>
  </div>
  <div class="bim"><button class="bb active" onclick="sB('B1')">1º Bim</button><button class="bb" onclick="sB('B2')">2º Bim</button><button class="bb" onclick="sB('B3')">3º Bim</button><button class="bb" onclick="sB('B4')">4º Bim</button></div>
  <div id="maw" style="display:none"></div>
  <div id="nl"></div>
</div>

<div id="sec-turmas" class="sec">
  <div class="sh"><span class="st">👥 Turmas cadastradas</span><button class="btn bp" onclick="tgFT()">+ Nova turma</button></div>
  <div id="ftw" style="display:none">
    <div class="fc">
      <div style="font-size:14px;font-weight:600;color:var(--purple-dark);margin-bottom:1rem">Cadastrar turma</div>
      <label class="fl">Nome da turma</label><input type="text" class="fi" id="ftn" placeholder="Ex: Y3 Alpha"/>
