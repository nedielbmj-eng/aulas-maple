function tgEx(id){exC[id]=!exC[id];rdD()}
function rdD(){const b=(document.getElementById("fdb")?.value||"").toLowerCase(),ft=document.getElementById("fdt")?.value||"";const fl=[...aulas].sort((a,b)=>(b.data||"").localeCompare(a.data||"")).filter(a=>(!b||a.conteudo.toLowerCase().includes(b)||(a.turmaNome||"").toLowerCase().includes(b))&&(!ft||String(a.tid)===ft));const sw=document.getElementById("sw"),fd=document.getElementById("fd");if(aulas.length){sw.style.display="grid";fd.style.display="flex";let tP=0,tF=0,tA=0;aulas.forEach(a=>{if(a.chamada)Object.values(a.chamada).forEach(s=>{tA++;if(s==="p")tP++;if(s==="f")tF++;})});const pct=tA?Math.round(tP/tA*100):0;sw.innerHTML=`<div class="sc scp"><div class="si">📓</div><div class="sn">${aulas.length}</div><div class="sl">Aulas</div></div><div class="sc sct"><div class="si">✅</div><div class="sn">${tP}</div><div class="sl">Presenças</div></div><div class="sc scr"><div class="si">❌</div><div class="sn">${tF}</div><div class="sl">Faltas</div></div><div class="sc sca"><div class="si">📊</div><div class="sn">${pct}%</div><div class="sl">Frequência</div></div>`;}else{sw.style.display="none";fd.style.display="none"}const w=document.getElementById("tlw");if(!fl.length){w.innerHTML=`<div class="empty"><span class="ei">📓</span>${aulas.length===0?"Nenhuma aula registrada.<br>Clique em <strong>+ Nova aula</strong> para começar.":"Nenhum resultado."}</div>`;return}let html="<div class='tl'>";fl.forEach(a=>{const ch=a.chamada||{},al=Object.keys(ch),nP=al.filter(x=>ch[x]==="p").length,nF=al.filter(x=>ch[x]==="f").length,nJ=al.filter(x=>ch[x]==="j").length,ex=exC[a.id];html+=`<div class="tli"><div class="tld" style="background:${nF>nP?"var(--red)":"var(--teal)"}"></div><div class="tlc"><div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px"><div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap"><span class="bdg bpt">${a.turmaNome||"—"}</span>${a.nota?`<span style="color:var(--amber);font-size:12px">${fNt(a.nota)}</span>`:""}</div><div style="display:flex;align-items:center;gap:5px"><span style="font-size:12px;color:var(--text3)">📅 ${fD(a.data)}</span><button class="ib" onclick="edA(${a.id})">✏️</button><button class="ib" onclick="dlA(${a.id})">🗑️</button></div></div>${a.conteudo?`<div style="font-size:14px;line-height:1.6;margin-bottom:6px">${a.conteudo}</div>`:""}${al.length?`<div class="pr">${nP?`<span class="bdg bpp">${nP} presente${nP!==1?"s":""}</span>`:""} ${nF?`<span class="bdg bpf">${nF} falta${nF!==1?"s":""}</span>`:""} ${nJ?`<span class="bdg bpj">${nJ} justif.</span>`:""}</div><button class="eb" onclick="tgEx(${a.id})">${ex?"▲ Ocultar":"▼ Ver"} chamada</button>${ex?`<div class="cg" style="margin-top:6px">${al.map(n=>`<div class="cr"><span class="cn">${n}</span><span class="bdg ${ch[n]==="p"?"bpp":ch[n]==="f"?"bpf":"bpj"}">${ch[n]==="p"?"P":ch[n]==="f"?"F":"J"}</span></div>`).join("")}</div>`:""}`:""}${a.obs?`<div style="font-size:12px;color:var(--text3);font-style:italic;margin-top:6px">📝 ${a.obs}</div>`:""}</div></div>`;});w.innerHTML=html+"</div>";}

function sB(b){bim=b;document.querySelectorAll(".bb").forEach((btn,i)=>btn.classList.toggle("active",BIMS[i]===b));rdN()}
function nK(t,a,b){return`${t}__${a}__${b}`}
function gNt(t,a,b){return notasDB[nK(t,a,b)]||{prova1:"",prova2:"",trabalho:"",participacao:"",comportamento:"o",obs:""}}
function mA(n){const v=[n.prova1,n.prova2,n.trabalho,n.participacao].map(x=>parseFloat(x)).filter(x=>!isNaN(x));if(!v.length)return null;return v.reduce((a,b)=>a+b,0)/v.length}
function mAn(ti,a){const ms=BIMS.map(b=>mA(gNt(ti,a,b))).filter(m=>m!==null);if(!ms.length)return null;return ms.reduce((a,b)=>a+b,0)/ms.length}
function rdN(){const sel=document.getElementById("nt");if(!sel)return;const tid=parseInt(sel.value),t=turmas.find(x=>x.id===tid);const w=document.getElementById("nl"),mw=document.getElementById("maw");if(!t){w.innerHTML="<div class='empty'><span class='ei'>⭐</span>Selecione uma turma.</div>";mw.style.display="none";return}if(!t.alunos.length){w.innerHTML="<div class='empty'><span class='ei'>👤</span>Nenhum aluno nesta turma.</div>";mw.style.display="none";return}const mAs=t.alunos.map(a=>({nome:a,m:mAn(tid,a)})).filter(x=>x.m!==null);if(mAs.length){mw.style.display="block";const tot=mAs.reduce((s,x)=>s+x.m,0)/mAs.length;const mc=tot>=7?"var(--teal-dark)":tot>=5?"var(--amber-dark)":"var(--red-dark)",mb=tot>=7?"var(--teal-light)":tot>=5?"var(--amber-light)":"var(--red-light)";mw.innerHTML=`<div class="ma"><div style="font-size:13px;font-weight:600;color:var(--purple-dark)">📊 ${t.nome}</div><div class="mc">${BIMS.map(b=>{const ms=t.alunos.map(a=>mA(gNt(tid,a,b))).filter(m=>m!==null);if(!ms.length)return`<span class="mcc" style="background:var(--bg3);color:var(--text3)">${b}: —</span>`;const avg=ms.reduce((s,v)=>s+v,0)/ms.length;const c=avg>=7?"var(--teal-dark)":avg>=5?"var(--amber-dark)":"var(--red-dark)",bg=avg>=7?"var(--teal-light)":avg>=5?"var(--amber-light)":"var(--red-light)";return`<span class="mcc" style="background:${bg};color:${c}">${b}: ${avg.toFixed(1)}</span>`}).join("")}<span class="mcc" style="background:${mb};color:${mc};font-weight:700">Anual: ${tot.toFixed(1)}</span></div></div>`;}else mw.style.display="none";
w.innerHTML=t.alunos.map(aluno=>{const n=gNt(tid,aluno,bim),med=mA(n),mAnu=mAn(tid,aluno);const mc=med===null?"var(--text3)":med>=7?"var(--teal-dark)":med>=5?"var(--amber-dark)":"var(--red-dark)",mb=med===null?"var(--bg3)":med>=7?"var(--teal-light)":med>=5?"var(--amber-light)":"var(--red-light)";const sl=aluno.replace(/\s/g,"_");return`<div class="nac"><div class="nh"><div style="display:flex;align-items:center;gap:8px"><div style="width:36px;height:36px;border-radius:50%;background:var(--purple-light);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--purple);flex-shrink:0">${aluno.slice(0,2).toUpperCase()}</div><div><span class="nn">${aluno}</span>${mAnu!==null?`<div style="font-size:11px;color:var(--text3);margin-top:1px">Anual: <b style="color:${mAnu>=7?"var(--teal-dark)":mAnu>=5?"var(--amber-dark)":"var(--red-dark)"}">${mAnu.toFixed(1)}</b></div>`:""}</div></div>${med!==null?`<span class="nm" style="background:${mb};color:${mc}">${bim}: ${med.toFixed(1)}</span>`:`<span class="nm" style="background:var(--bg3);color:var(--text3)">Sem notas</span>`}</div><div class="nr"><div class="nrr"><span class="nrl">📝 Prova 1</span><input class="ni" type="number" min="0" max="10" step="0.1" placeholder="—" value="${n.prova1}" id="np1-${tid}-${sl}-${bim}"/></div><div class="nrr"><span class="nrl">📝 Prova 2</span><input class="ni" type="number" min="0" max="10" step="0.1" placeholder="—" value="${n.prova2}" id="np2-${tid}-${sl}-${bim}"/></div><div class="nrr"><span class="nrl">📋 Trabalho</span><input class="ni" type="number" min="0" max="10" step="0.1" placeholder="—" value="${n.trabalho}" id="ntb-${tid}-${sl}-${bim}"/></div><div class="nrr"><span class="nrl">✋ Participação</span><input class="ni" type="number" min="0" max="10" step="0.1" placeholder="—" value="${n.participacao}" id="npt-${tid}-${sl}-${bim}"/></div><div class="nrr"><span class="nrl">😊 Comportamento</span><div class="cb"><button class="cbtn co ${n.comportamento==="o"?"":"off"}" onclick="sComp(${tid},'${aluno.replace(/'/g,"\\'")}','${bim}','o')">Ótimo</button><button class="cbtn crr ${n.comportamento==="r"?"":"off"}" onclick="sComp(${tid},'${aluno.replace(/'/g,"\\'")}','${bim}','r')">Regular</button><button class="cbtn cp ${n.comportamento==="p"?"":"off"}" onclick="sComp(${tid},'${aluno.replace(/'/g,"\\'")}','${bim}','p')">Precisa melhorar</button></div></div><div class="nrr"><span class="nrl">📝 Observação</span><input class="no" type="text" placeholder="Anotação livre..." value="${n.obs||""}" id="nob-${tid}-${sl}-${bim}"/></div></div></div>`;}).join("");}
function sComp(ti,a,b,v){const k=nK(ti,a,b);if(!notasDB[k])notasDB[k]=gNt(ti,a,b);notasDB[k].comportamento=v;sv();rdN()}
function svN(){const sel=document.getElementById("nt"),tid=parseInt(sel.value),t=turmas.find(x=>x.id===tid);if(!t){alert("Selecione uma turma.");return}t.alunos.forEach(a=>{const k=nK(tid,a,bim),sl=a.replace(/\s/g,"_"),cur=notasDB[k]||{comportamento:"o"};notasDB[k]={...cur,prova1:document.getElementById(`np1-${tid}-${sl}-${bim}`)?.value||"",prova2:document.getElementById(`np2-${tid}-${sl}-${bim}`)?.value||"",trabalho:document.getElementById(`ntb-${tid}-${sl}-${bim}`)?.value||"",participacao:document.getElementById(`npt-${tid}-${sl}-${bim}`)?.value||"",obs:document.getElementById(`nob-${tid}-${sl}-${bim}`)?.value||""};});sv();rdN();const btn=document.querySelector("#sec-notas .bc");if(btn){btn.textContent="✓ Salvo!";setTimeout(()=>{btn.innerHTML="💾 Salvar notas"},1500)}}

function sAT(t){document.querySelectorAll(".tmb").forEach((b,i)=>b.classList.toggle("active",["m","e","p"][i]===t));document.getElementById("tabm").style.display=t==="m"?"block":"none";document.getElementById("tabe").style.display=t==="e"?"block":"none";document.getElementById("tabp").style.display=t==="p"?"block":"none";}
function hDr(e){e.preventDefault();document.getElementById("idr").classList.remove("dv");const f=e.dataTransfer.files[0];if(f)hFI(f)}
function hFI(file){if(!file)return;const ext=file.name.split(".").pop().toLowerCase();const r=new FileReader();r.onload=function(e){try{if(ext==="csv"||!["xlsx","xls"].includes(ext)){const lines=e.target.result.split(/\r?\n/).filter(l=>l.trim());iHdr=lines[0].split(/[,;\t]/).map(h=>h.trim().replace(/^"|"$/g,""));iRows=lines.slice(1).map(l=>l.split(/[,;\t]/).map(v=>v.trim().replace(/^"|"$/g,"")));}else{// xlsx básico: tenta ler como binário com XLSX se disponível
if(typeof XLSX!=="undefined"){const d=new Uint8Array(e.target.result);const wb=XLSX.read(d,{type:"array"});const ws=wb.Sheets[wb.SheetNames[0]];const js=XLSX.utils.sheet_to_json(ws,{header:1,defval:""});iHdr=(js[0]||[]).map(h=>String(h).trim());iRows=js.slice(1).filter(row=>row.some(v=>String(v).trim()));}else{alert("Para arquivos .xlsx, use .csv (mais simples). Salve como CSV no Excel: Arquivo > Salvar como > CSV.");return;}}bCS();}catch(er){alert("Erro ao ler. Tente salvar como CSV.");}};if(ext==="csv"||!["xlsx","xls"].includes(ext))r.readAsText(file,"UTF-8");else r.readAsArrayBuffer(file);}
function bCS(){const s=document.getElementById("csl");s.innerHTML=iHdr.map((h,i)=>`<option value="${i}">${h||"Coluna "+(i+1)}</option>`).join("");const b=iHdr.findIndex(h=>/nome|aluno|student|name/i.test(h));if(b>=0)s.value=b;aCS();}
function aCS(){const c=parseInt(document.getElementById("csl").value)||0;const ns=iRows.map(r=>String(r[c]||"").trim()).filter(n=>n&&n.length>1);document.getElementById("icl").textContent=`${ns.length} aluno${ns.length!==1?"s":""} encontrado${ns.length!==1?"s":""}`;document.getElementById("iht").textContent=`(${iRows.length} linhas)`;document.getElementById("ich").innerHTML=ns.slice(0,20).map(n=>`<span class="icc">${n}</span>`).join("")+(ns.length>20?`<span class="icc" style="background:var(--bg3)">+${ns.length-20} mais</span>`:"");document.getElementById("ipr").style.display="block";}
function cfI(){const c=parseInt(document.getElementById("csl").value)||0;const ns=iRows.map(r=>String(r[c]||"").trim()).filter(n=>n&&n.length>1);ns.forEach(n=>{if(!aFT.includes(n))aFT.push(n)});rdAF();cnI();sAT("m");}
function cnI(){document.getElementById("ipr").style.display="none";document.getElementById("fi2").value="";iRows=[];iHdr=[];}

function prLP(){
  const raw=document.getElementById("ftp").value;
  if(!raw.trim()){alert("Cole a lista primeiro.");return;}
  const lines=raw.split(/\n/).map(l=>l.trim()).filter(l=>l.length>0);
  const nomes=lines.map(l=>{
    // Remove numeração: "1.", "1-", "1)", "- ", "• ", números soltos
    return l
      .replace(/^\d+[.\-)\s]+/,"")
      .replace(/^[-•*>]+\s*/,"")
      .replace(/\s*\(.*?\)/g,"")  // remove parênteses tipo (ausente)
      .replace(/\s+/g," ")
      .trim();
  }).filter(n=>n.length>1);
  let adicionados=0;
  nomes.forEach(n=>{if(!aFT.includes(n)){aFT.push(n);adicionados++;}});
  rdAF();
  document.getElementById("lp-info").textContent=adicionados+" aluno"+( adicionados!==1?"s":"")+" adicionado"+(adicionados!==1?"s":"")+"!";
  document.getElementById("ftp").value="";
  setTimeout(()=>{document.getElementById("lp-info").textContent="";},3000);
}

function tgFT(){aFT=[];document.getElementById("ftn").value="";document.getElementById("fta").value="";document.getElementById("ftl").innerHTML="";if(document.getElementById("ftp"))document.getElementById("ftp").value="";if(document.getElementById("lp-info"))document.getElementById("lp-info").textContent="";cnI();sAT("m");const w=document.getElementById("ftw");w.style.display=w.style.display==="none"?"block":"none";}
function canFT(){document.getElementById("ftw").style.display="none";aFT=[]}
function aAF(){const i=document.getElementById("fta");const n=i.value.trim();if(!n)return;if(!aFT.includes(n))aFT.push(n);i.value="";rdAF()}
function rmAF(n){aFT=aFT.filter(x=>x!==n);rdAF()}
function rdAF(){document.getElementById("ftl").innerHTML=aFT.length?`<div style="font-size:11px;color:var(--text3);margin-bottom:5px;font-weight:600">${aFT.length} aluno${aFT.length!==1?"s":""} na lista</div>`+aFT.map(n=>`<span class="chip">${n}<span class="rm" onclick="rmAF('${n.replace(/'/g,"\\'")}')">×</span></span>`).join(""):""}
function svT(){const n=document.getElementById("ftn").value.trim();if(!n){alert("Informe o nome da turma.");return}if(!aFT.length&&!confirm("Salvar sem alunos?"))return;turmas.push({id:Date.now(),nome:n,alunos:[...aFT]});sv();canFT();rAll();}
function dlT(id){if(!confirm("Remover turma?"))return;turmas=turmas.filter(t=>t.id!==id);sv();rAll()}
function aAT(id){const i=document.getElementById("ai-"+id);const n=i.value.trim();if(!n)return;const t=turmas.find(x=>x.id===id);if(!t)return;if(!t.alunos.includes(n))t.alunos.push(n);i.value="";sv();rdT();pSel()}
function rmAT(tid,n){const t=turmas.find(x=>x.id===tid);if(!t)return;t.alunos=t.alunos.filter(a=>a!==n);sv();rdT()}
function rdT(){const w=document.getElementById("tl");if(!turmas.length){w.innerHTML="<div class='empty'><span class='ei'>👥</span>Nenhuma turma cadastrada ainda.</div>";return}w.innerHTML=turmas.map(t=>`<div class="card"><div style="display:flex;align-items:center;justify-content:space-between;gap:8px"><div style="display:flex;align-items:center;gap:10px"><div class="ta">🏫</div><div><div style="font-size:15px;font-weight:600">${t.nome}</div><div style="font-size:12px;color:var(--text3)">${t.alunos.length} aluno${t.alunos.length!==1?"s":""}</div></div></div><button class="ib" onclick="dlT(${t.id})">🗑️</button></div><div class="aw">${t.alunos.map(a=>`<span class="chip">${a}<span class="rm" onclick="rmAT(${t.id},'${a.replace(/'/g,"\\'")}')">×</span></span>`).join("")}</div><div class="ar"><input type="text" id="ai-${t.id}" placeholder="Novo aluno..." onkeydown="if(event.key==='Enter')aAT(${t.id})"/><button class="btn bp" onclick="aAT(${t.id})" style="padding:6px 11px;font-size:12px">+ Add</button></div></div>`).join("");}

function tgFR(){document.getElementById("frd").value=td();document.getElementById("frt").value="";document.getElementById("frti").value="";document.getElementById("frte").value="";document.getElementById("fra").value="";const w=document.getElementById("frw");w.style.display=w.style.display==="none"?"block":"none";}
function canFR(){document.getElementById("frw").style.display="none"}
function svR(){const ti=document.getElementById("frti").value.trim(),te=document.getElementById("frte").value.trim();if(!ti||!te){alert("Preencha o título e o conteúdo.");return}const tid=document.getElementById("frt").value,t=turmas.find(x=>x.id===parseInt(tid));relats.unshift({id:Date.now(),data:document.getElementById("frd").value,tid:parseInt(tid)||null,turmaNome:t?t.nome:"",titulo:ti,texto:te,atencao:document.getElementById("fra").value.trim()});sv();canFR();rdRl();}
function dlR(id){if(!confirm("Remover?"))return;relats=relats.filter(r=>r.id!==id);sv();rdRl()}
function rdRl(){const w=document.getElementById("rl");if(!relats.length){w.innerHTML="<div class='empty'><span class='ei'>📄</span>Nenhum relatório ainda.</div>";return}w.innerHTML=relats.map(r=>`<div class="rc"><div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px"><div><div style="font-size:14px;font-weight:600;margin-bottom:4px">${r.titulo}</div><div style="font-size:11px;color:var(--text3);display:flex;gap:10px"><span>📅 ${fD(r.data)}</span>${r.turmaNome?`<span>👥 ${r.turmaNome}</span>`:""}</div></div><button class="ib" onclick="dlR(${r.id})">🗑️</button></div><div style="font-size:14px;line-height:1.6;margin-top:8px">${r.texto}</div>${r.atencao?`<div style="margin-top:8px;padding:6px 10px;background:var(--amber-light);border-radius:var(--rs);font-size:12px;color:var(--amber-dark)">⚠️ ${r.atencao}</div>`:""}</div>`).join("");}

function tgFP(){pG="";document.getElementById("fpte").value="";document.getElementById("fpob").value="";document.getElementById("fpt").value="";document.getElementById("airw").style.display="none";document.getElementById("airt").textContent="";document.getElementById("bsp").style.display="none";const w=document.getElementById("fpw");w.style.display=w.style.display==="none"?"block":"none";}
function canFP(){document.getElementById("fpw").style.display="none";pG=""}
async function gP(){const te=document.getElementById("fpte").value.trim(),ob=document.getElementById("fpob").value.trim(),du=document.getElementById("fpd").value,tid=document.getElementById("fpt").value,t=turmas.find(x=>x.id===parseInt(tid));if(!te){alert("Informe o tema.");return}const btn=document.getElementById("bgr");btn.disabled=true;btn.textContent="⏳ Gerando...";document.getElementById("airw").style.display="block";document.getElementById("airt").innerHTML="<span style='color:var(--purple);font-style:italic'>A IA está criando seu plano...</span>";document.getElementById("bsp").style.display="none";try{const res=await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({model:"claude-sonnet-4-20250514",max_tokens:1000,messages:[{role:"user",content:`Você é especialista em educação tecnológica. Crie um plano de aula completo para Tecnologia:\n\nTema: ${te}\n${ob?"Objetivo: "+ob:""}\nDuração: ${du}\n${t?"Turma: "+t.nome+" ("+t.alunos.length+" alunos)":""}\n\n1. Objetivo geral\n2. Competências trabalhadas\n3. Materiais necessários\n4. Desenvolvimento passo a passo com tempos\n5. Avaliação\n6. Dica extra para o professor`}]})});const da=await res.json();const tx=da.content?.find(b=>b.type==="text")?.text||"Não foi possível gerar.";pG=tx;document.getElementById("airt").textContent=tx;document.getElementById("bsp").style.display="inline-flex";}catch(e){document.getElementById("airt").innerHTML="<span style='color:var(--red)'>Erro ao conectar com a IA. Verifique sua conexão.</span>";}btn.disabled=false;btn.innerHTML="✨ Gerar novamente";}
function svP(){if(!pG)return;const te=document.getElementById("fpte").value.trim(),du=document.getElementById("fpd").value,tid=document.getElementById("fpt").value,t=turmas.find(x=>x.id===parseInt(tid));planos.unshift({id:Date.now(),data:td(),tema:te,duracao:du,turmaNome:t?t.nome:"",texto:pG});sv();canFP();rdPl();}
function dlP(id){if(!confirm("Remover?"))return;planos=planos.filter(p=>p.id!==id);sv();rdPl()}
function rdPl(){const w=document.getElementById("pl");if(!planos.length){w.innerHTML="<div class='empty'><span class='ei'>🧠</span>Nenhum plano gerado ainda.</div>";return}w.innerHTML=planos.map(p=>`<div class="pc"><div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px"><div><div style="font-size:14px;font-weight:600;margin-bottom:4px">${p.tema}</div><div style="font-size:11px;color:var(--text3);display:flex;gap:10px"><span>📅 ${fD(p.data)}</span><span>⏱️ ${p.duracao}</span>${p.turmaNome?`<span>👥 ${p.turmaNome}</span>`:""}</div></div><button class="ib" onclick="dlP(${p.id})">🗑️</button></div><div style="font-size:13px;line-height:1.7;white-space:pre-wrap;margin-top:8px">${p.texto}</div></div>`).join("");}

