function rAll(){pSel();rdAg();rdD();rdT();rdRl();rdPl();}
function showTab(t){document.querySelectorAll(".nb").forEach((b,i)=>b.classList.toggle("active",["agenda","diario","notas","turmas","relatorios","planos"][i]===t));document.querySelectorAll(".sec").forEach(s=>s.classList.remove("active"));document.getElementById("sec-"+t).classList.add("active");if(t==="notas")rdN();}
function pSel(){["fat","fdt","frt","fpt","nt"].forEach(id=>{const el=document.getElementById(id);if(!el)return;const c=el.value;el.innerHTML=(id==="fdt"||id==="nt")?"<option value=''>Todas as turmas</option>":"<option value=''>— selecione —</option>";turmas.forEach(t=>el.innerHTML+=`<option value="${t.id}">${t.nome}</option>`);if(c)el.value=c;});}
function fD(d){if(!d)return"";const[y,m,dd]=d.split("-");return`${dd}/${m}/${y}`}
function fNt(n){return n?"★".repeat(n)+"☆".repeat(5-n):""}
function td(){return new Date().toISOString().slice(0,10)}
function toM(hm){const[h,m]=hm.split(":").map(Number);return h*60+m}
function nM(){const n=new Date();return n.getHours()*60+n.getMinutes()}
function p2(n){return String(n).padStart(2,"0")}
function fC(d){return p2(d.getHours())+":"+p2(d.getMinutes())+":"+p2(d.getSeconds())}

function bP(tp){try{const c=new(window.AudioContext||window.webkitAudioContext)();const sq=tp==="w"?[[440,.15],[0,.05],[440,.15],[0,.05],[440,.15]]:[[880,.25],[0,.06],[880,.25],[0,.06],[880,.4]];let t=c.currentTime;sq.forEach(([f,d])=>{if(f>0){const o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.type="sine";o.frequency.value=f;g.gain.setValueAtTime(.5,t);g.gain.exponentialRampToValueAtTime(.001,t+d);o.start(t);o.stop(t+d);}t+=d+.03;});}catch(e){}}

function shAl(tp,dc,tr,hr){
  const ov=document.getElementById("ao");
  const isW=(tp==="w"||tp==="i");
  const icon=tp==="i"?"🔔":tp==="w"?"⏰":"🔕";
  const title=tp==="i"?"Aula começando agora!":tp==="w"?"5 minutos para acabar!":"Aula encerrada!";
  const sub=tp==="i"?dc+" \u2014 "+tr+" iniciou \u00e0s "+hr:tp==="w"?dc+" \u2014 "+tr+" termina \u00e0s "+hr:dc+" \u2014 "+tr+" terminou \u00e0s "+hr;
  ov.innerHTML='<div class="ab '+(isW?"warn":"end")+'"><div class="abic">'+icon+'</div><div style="flex:1"><div class="abt">'+title+'</div><div class="abs">'+sub+'</div></div><button class="ac" onclick="fAl()">\u00d7</button></div>';
  ov.classList.add("show");
  if(alOn)bP(isW?"w":"e");
  setTimeout(fAl,15000);
}
function fAl(){document.getElementById("ao").classList.remove("show")}
function tgAlarm(){alOn=document.getElementById("atgl").checked;document.getElementById("ats").textContent=alOn?"Avisa no in\u00edcio, 5 min antes e quando acabar":"Alarmes desativados";}

function chAl(){
  if(!alOn)return;
  const now=new Date();
  const ag=now.getHours()*60+now.getMinutes();
  const sec=now.getSeconds();
  if(sec>8)return; // dispara apenas nos primeiros 8s do minuto
  AGD.filter(x=>x.d===dh).forEach(function(sl){
    const im=toM(sl.i);
    const fm=toM(sl.f);
    const ki="i_"+sl.d+"_"+sl.i;
    const k5="w_"+sl.d+"_"+sl.i;
    const ke="e_"+sl.d+"_"+sl.i;
    if(ag===im&&!aFrd[ki]){aFrd[ki]=true;shAl("i",sl.dc,sl.t,sl.i);}
    if(ag===fm-5&&!aFrd[k5]){aFrd[k5]=true;shAl("w",sl.dc,sl.t,sl.f);}
    if(ag===fm&&!aFrd[ke]){aFrd[ke]=true;shAl("e",sl.dc,sl.t,sl.f);}
  });
}
function uCk(){const n=new Date();document.getElementById("clk").textContent=fC(n);chAl();if(document.getElementById("sec-agenda").classList.contains("active"))uCd();}
function uCd(){
  const ag=nM(),ns=new Date().getSeconds();
  document.querySelectorAll(".as").forEach(el=>{
    const i=el.dataset.i,f=el.dataset.f;
    if(!i||!f)return;
    const iM=toM(i),fM=toM(f);
    const cd=el.querySelector(".scd"),st=el.querySelector(".ss");
    if(ag>=iM&&ag<fM){
      el.classList.add("ea");el.classList.remove("ep");
      const rm=fM-ag-1,rs=60-ns;
      if(cd)cd.textContent=p2(rm)+":"+(rs===60?"00":p2(rs));
      if(st)st.innerHTML="<span style='color:var(--purple)'>▶ Em andamento</span>";
    }else if(ag>=fM-5&&ag<fM){
      el.classList.add("ep");el.classList.remove("ea");
      const rm=fM-ag-1,rs=60-ns;
      if(cd)cd.textContent=p2(rm)+":"+(rs===60?"00":p2(rs));
      if(st)st.innerHTML="<span style='color:var(--amber-dark)'>⏰ Encerrando em breve</span>";
    }else if(ag>=fM){
      el.classList.remove("ea","ep");
      if(cd)cd.textContent="";
      if(st)st.innerHTML="<span style='color:var(--text3)'>Encerrada</span>";
    }else{
      el.classList.remove("ea","ep");
      if(cd)cd.textContent="";
      if(st)st.innerHTML="";
    }
  });
}
setInterval(uCk,1000);uCk();

function rdAg(){document.getElementById("adias").innerHTML=DIAS.map(d=>`<button class="db${dA===d?" active":""}" onclick="sD('${d}')">${d}</button>`).join("");const sl=AGD.filter(s=>s.d===dA).sort((a,b)=>a.i.localeCompare(b.i));const w=document.getElementById("aslots");if(!sl.length){w.innerHTML="<div class='empty'><span class='ei'>📅</span>Sem aulas neste dia.</div>";return}const ag=nM();w.innerHTML=sl.map(s=>{const cls=s.dc==="TECNOLOGIA"?"tec":(s.dc.includes("Rob")||s.dc.includes("Prog")||s.dc.includes("Intel"))?"rob":"oth";const col=cls==="tec"?"var(--purple)":cls==="rob"?"var(--teal)":"var(--text3)";const iM=toM(s.i),fM=toM(s.f);const eA=dA===dh&&ag>=iM&&ag<fM,en=dA===dh&&ag>=fM-5&&ag<fM;return`<div class="as ${cls}${eA?" ea":en?" ep":""}" data-i="${s.i}" data-f="${s.f}"><div class="stm">🕐 ${s.i}–${s.f}</div><div style="flex:1"><div class="sd" style="color:${col}">${s.dc}</div><div class="str">👥 ${s.t}</div><div class="ss"></div></div><div class="scd"></div></div>`;}).join("");uCd();}
